# Webcam Simulator Configuration
# Copy this file to .env and update with your values

# AWS API Gateway URL (required)
API_URL=https://your-api.execute-api.us-east-1.amazonaws.com/Prod

# API Key for authentication (required)
# Must match WEBCAM_API_KEY in AWS SAM template.yaml
WEBCAM_API_KEY=test-api-key-12345

# City to simulate webcam from (required)
# Options: Vienna, Berlin, Paris
WEBCAM_CITY=Vienna

# Base date for simulated timestamps (required)
# Format: YYYY-MM-DD
WEBCAM_DATE=2025-12-01

# Delay between uploads in seconds (optional, default: 0.5)
# Lower values = faster uploads, higher values = more realistic timing
WEBCAM_DELAY=0.5

# Limit number of images to upload (optional, default: all 288 images)
# Useful for quick testing. Set to 0 or leave empty to upload all images
WEBCAM_LIMIT=0
